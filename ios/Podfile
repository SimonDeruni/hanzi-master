# Define a global platform for your project
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = '1'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get has been executed first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/\AFLUTTER_ROOT=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig and running flutter pub get again."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # Add ML Kit Chinese Text Recognition
  pod 'GoogleMLKit/TextRecognitionChinese', '~> 9.0.0'

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Force project-level deployment target to fix privacy bundle target errors
  installer.pods_project.build_configurations.each do |config|
    config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "15.5"
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Required for Google ML Kit and other dependencies
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['CODE_SIGN_IDENTITY'] = '-'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_SPEECH_RECOGNIZER=1',
      ]
    end
  end

  # CocoaPods 1.13+ generates separate projects for pods, apply settings there too
  if installer.respond_to?(:generated_projects)
    installer.generated_projects.each do |project|
      project.build_configurations.each do |config|
        config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "15.5"
      end
      project.targets.each do |target|
        target.build_configurations.each do |config|
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
          config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
          config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
          config.build_settings['CODE_SIGN_IDENTITY'] = '-'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
            '$(inherited)',
            'PERMISSION_MICROPHONE=1',
            'PERMISSION_SPEECH_RECOGNIZER=1',
          ]
        end
      end
    end
  end

  # Xcode's archive dependency analysis detects a cycle when Flutter's
  # "Thin Binary" phase mutates Runner.app before the widget extension is
  # copied into it. CocoaPods can rewrite the Runner phases on clean CI
  # machines, so enforce the required order after every pod install.
  installer.aggregate_targets
           .map(&:user_project)
           .compact
           .uniq
           .each do |user_project|
    runner_target = user_project.targets.find { |target| target.name == 'Runner' }
    next unless runner_target

    embed_extension_phase = runner_target.build_phases.find do |phase|
      phase.respond_to?(:name) && phase.name == 'Embed App Extensions'
    end
    thin_binary_phase = runner_target.build_phases.find do |phase|
      phase.respond_to?(:name) && phase.name == 'Thin Binary'
    end

    unless embed_extension_phase && thin_binary_phase
      raise 'Runner must contain Embed App Extensions and Thin Binary build phases'
    end

    runner_target.build_phases.delete(embed_extension_phase)
    thin_binary_index = runner_target.build_phases.index(thin_binary_phase)
    runner_target.build_phases.insert(thin_binary_index, embed_extension_phase)
    user_project.save
  end
end
